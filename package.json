{
  "name": "@local/pdx-forge",
  "version": "1.0.0",
  "private": true,
  "description": "PDX Forge: a sidebar workshop that generates Paradox script and localization for EU5 advances, decisions, events, privileges and laws.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
